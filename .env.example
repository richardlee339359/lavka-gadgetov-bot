# ═══════════════════════════════════════════════════════════
#  Скопируй этот файл в .env и заполни своими значениями:
#     Windows:  copy .env.example .env
#     Linux/Mac: cp .env.example .env
#  Файл .env в git не попадает — он в .gitignore.
# ═══════════════════════════════════════════════════════════


# ─── TELEGRAM ──────────────────────────────────────────────
# Токен от @BotFather: /newbot → имя → username → токен
TG_BOT_TOKEN=

# Твой Telegram ID (узнать: напиши @userinfobot).
# Нужен только для служебной команды /stats — можно оставить пустым.
ADMIN_TG_ID=


# ─── GOOGLE GEMINI: ПО ОДНОМУ КЛЮЧУ НА ПРОЕКТ ──────────────
# Ключи берутся в https://aistudio.google.com → Get API key.
# Квоты Google считаются НА ПРОЕКТ, поэтому 3 проекта = 3 независимых лимита.
# Ключей может быть сколько угодно: GEMINI_KEY_1, GEMINI_KEY_2, ... GEMINI_KEY_50.
# Программа сама подхватит все переменные с префиксом GEMINI_KEY_.
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=


# ─── КАСКАД МОДЕЛЕЙ: ОТ СТАРШЕЙ К МЛАДШЕЙ ──────────────────
# Порядок важен. Сначала пробуем первую модель на ВСЕХ ключах,
# и только когда все ключи выжаты — спускаемся на следующую.
#
# Эти четыре проверены на живом бесплатном ключе и работают:
MODEL_CASCADE=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
#
# ⚠️  Google регулярно выводит модели из обращения. Если увидишь ошибку
#     «модели не существует» — загляни в https://aistudio.google.com → Models
#     и обнови этот список. Старые gemini-2.5-* новым ключам уже недоступны.
#
# 💡 Хочешь увидеть каскад в действии за одну секунду — поставь первой
#     gemini-3.1-pro-preview. На бесплатном ключе она сразу отдаёт 429,
#     и в логах видно, как работа уходит на flash:
#     MODEL_CASCADE=gemini-3.1-pro-preview,gemini-3.8-flash,gemini-3.5-flash-lite


# ─── ПОВЕДЕНИЕ ─────────────────────────────────────────────
# Температура: 0 — сухой и предсказуемый, 1 — живой и разный
AI_TEMPERATURE=0.9

# Сколько последних сообщений диалога помнит бот
HISTORY_LIMIT=12

# На сколько секунд ключ уходит в «отдых» после ошибки 429
KEY_COOLDOWN_SEC=60

# Кто встречает нового пользователя: kira | olga | stepan
DEFAULT_PERSONA=kira

# Путь к базе магазина
DB_PATH=./shop.db


# ─── TELEGRAM PREMIUM: КАСТОМНЫЕ ЭМОДЗИ ────────────────────
# Если выключено — используются обычные эмодзи (работает у всех).
USE_CUSTOM_EMOJI=false
